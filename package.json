{
  "name": "shir",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run && pnpm -r --if-present test",
    "stylelint": "stylelint \"**/*.css\" --allow-empty-input --max-warnings 0",
    "check:samples": "node scripts/check-samples.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "pnpm --filter desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-css-modules": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-use-logical": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}

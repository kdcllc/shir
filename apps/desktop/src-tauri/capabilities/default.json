{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-save-song",
    "allow-get-song",
    "allow-list-songs",
    "allow-delete-song",
    "allow-search-songs",
    "allow-read-text-file",
    "allow-save-export-docx",
    "allow-list-setlists",
    "allow-get-setlist",
    "allow-create-setlist",
    "allow-rename-setlist",
    "allow-delete-setlist",
    "allow-duplicate-setlist",
    "allow-add-setlist-items",
    "allow-remove-setlist-item",
    "allow-reorder-setlist-items",
    "allow-update-setlist-item",
    "allow-log-webview-error"
  ]
}
